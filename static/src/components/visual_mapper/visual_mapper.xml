<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="data_migration.VisualMapperWidget">
        <div class="o_visual_mapper_container d-flex flex-column h-100 position-relative bg-view" 
             t-ref="mapperContainer"
             t-on-mousemove="(e) => this.onCanvasMouseMove(e)">
            
            <!-- Top Control Bar -->
            <div class="o_visual_mapper_header d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-view shadow-sm flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <!-- Mode Switcher Tabs -->
                    <div class="btn-group" role="group">
                        <button type="button" 
                                t-attf-class="btn #{state.activeMode == 'transform' ? 'btn-primary fw-bold' : 'btn-outline-primary'}"
                                t-on-click="() => this.switchMode('transform')">
                            <i class="fa fa-cogs me-1"/>Stage 1: Transformations (<t t-out="state.transformations.length"/>)
                        </button>
                        <button type="button" 
                                t-attf-class="btn #{state.activeMode == 'mapping' ? 'btn-primary fw-bold' : 'btn-outline-primary'}"
                                t-on-click="() => this.switchMode('mapping')">
                            <i class="fa fa-arrows-h me-1"/>Stage 2: Target Field Mapping (<t t-out="state.mappings.length"/>)
                        </button>
                    </div>

                    <span t-if="state.templateName" class="badge bg-secondary text-white px-2 py-1 fs-6">
                        <i class="fa fa-database me-1"/><t t-out="state.connectionName"/> &amp;rarr; <t t-out="state.targetModelName"/>
                    </span>
                    <span t-if="state.extractionName" class="badge bg-info text-dark px-2 py-1 fs-6 ms-1" title="Active Extraction Query">
                        <i class="fa fa-filter me-1"/><t t-out="state.extractionName"/>
                    </span>
                </div>

                <!-- Right Action Buttons -->
                <div class="d-flex align-items-center gap-2">
                    <t t-if="state.activeMode == 'mapping'">
                        <button class="btn btn-sm btn-outline-info" t-on-click="autoMapMatching" title="Auto-match source/derived variables with target field names">
                            <i class="fa fa-magic me-1"/>Auto-Map
                        </button>
                        <button class="btn btn-sm btn-outline-danger" t-on-click="clearAllMappings" title="Clear all field mappings">
                            <i class="fa fa-eraser me-1"/>Clear Mappings
                        </button>
                    </t>
                    <t t-if="state.activeMode == 'transform'">
                        <button class="btn btn-sm btn-outline-success" t-on-click="addNewTransformation" title="Add a new transformation rule">
                            <i class="fa fa-plus me-1"/>Add Rule
                        </button>
                    </t>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="loadData" title="Reload schema and state">
                        <i class="fa fa-refresh me-1"/>Reload
                    </button>
                    
                    <button class="btn btn-sm btn-primary fw-bold ms-2" t-on-click="saveAll" t-att-disabled="state.isSaving">
                        <i t-if="!state.isSaving" class="fa fa-save me-1"/>
                        <i t-if="state.isSaving" class="fa fa-spinner fa-spin me-1"/>
                        Save All Changes
                    </button>
                </div>
            </div>

            <!-- Loading State -->
            <div t-if="state.isLoading" class="d-flex flex-column align-items-center justify-content-center flex-grow-1 p-5">
                <div class="spinner-border text-primary me-2" role="status"/>
                <p class="mt-3 text-muted">Introspecting schema and loading transformation pipelines...</p>
            </div>

            <!-- MODE 1: TRANSFORMATION STUDIO -->
            <div t-if="!state.isLoading and state.activeMode == 'transform'" class="o_transform_studio d-flex flex-grow-1 overflow-hidden">
                
                <!-- Left Panel: Raw / Extracted Source Columns -->
                <div class="border-end bg-light d-flex flex-column" style="width: 260px; min-width: 240px;">
                    <div class="p-3 border-bottom bg-view">
                        <span class="fw-bold text-uppercase fs-7 text-muted">
                            <i class="fa fa-columns me-1"/> <t t-if="state.extractionName">Extraction Columns</t><t t-else="">Raw Columns</t> (<t t-out="state.rawColumns.length"/>)
                        </span>
                        <input type="text" class="form-control form-control-sm mt-2" placeholder="Filter columns..." t-model="state.sourceSearch"/>
                    </div>
                    <div class="p-2 overflow-auto flex-grow-1">
                        <t t-foreach="filteredRawColumns" t-as="col" t-key="col">
                            <div class="p-2 mb-1 rounded bg-view border border-light d-flex align-items-center justify-content-between hover-bg-light cursor-pointer"
                                 t-on-click="() => this.addTransformForColumn(col)">
                                <span class="fw-semibold text-truncate" t-out="col"/>
                                <button class="btn btn-xs btn-outline-primary" title="Add transformation rule">
                                    <i class="fa fa-plus"/>
                                </button>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Center Panel: Transformation Pipeline -->
                <div class="d-flex flex-column flex-grow-1 border-end overflow-auto bg-white p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="fa fa-list-ol me-2 text-primary"/>Transformation Pipeline (<t t-out="state.transformations.length"/>)
                            </h6>
                            <button class="btn btn-sm btn-primary py-1 px-2" t-on-click="addNewTransformation">
                                <i class="fa fa-plus me-1"/> Add Rule
                            </button>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <!-- Filter by variable name -->
                            <div class="input-group input-group-sm" style="width: 170px;">
                                <span class="input-group-text"><i class="fa fa-search"/></span>
                                <input type="text" class="form-control" placeholder="Search rules..." t-model="state.transformSearch"/>
                            </div>
                            <!-- Filter by category -->
                            <select class="form-select form-select-sm" t-model="state.transformCategoryFilter" style="width: 150px;">
                                <option value="">All Categories</option>
                                <option value="cleansing">Cleansing</option>
                                <option value="filter_row">Row Filter</option>
                                <option value="date_format">Date Format</option>
                                <option value="unit_conversion">Unit Conv</option>
                                <option value="type_conversion">Type Cast</option>
                                <option value="value_map">Value Map</option>
                                <option value="math_expr">Math</option>
                                <option value="string_slice">Slice / Split</option>
                                <option value="slugify">Slugify</option>
                                <option value="case_when">Case-When</option>
                                <option value="python_expr">Python</option>
                                <option value="ai_prompt">AI Prompt</option>
                            </select>
                            <!-- Presets -->
                            <select class="form-select form-select-sm" t-model="state.selectedPresetId" t-on-change="applyTransformPreset" style="width: 180px;">
                                <option value="">Apply Preset...</option>
                                <t t-foreach="state.transformPresets" t-as="p" t-key="p.id">
                                    <option t-att-value="p.id"><t t-out="p.name"/></option>
                                </t>
                            </select>
                        </div>
                    </div>

                    <t t-if="filteredTransformations.length == 0">
                        <div class="alert alert-info d-flex align-items-center my-4">
                            <i class="fa fa-info-circle fs-4 me-3"/>
                            <div>
                                <strong>No matching transformations.</strong>
                                <p class="mb-0 fs-7">No transformation rules match your current filter query. Click '+ Add Rule' or select a raw column on the left.</p>
                            </div>
                        </div>
                    </t>

                    <t t-foreach="filteredTransformations" t-as="t" t-key="t_index">
                        <div t-attf-class="card mb-3 border shadow-sm #{state.selectedTransformIndex == t_index ? 'border-primary' : ''}">
                            <div class="card-header bg-light py-2 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary">#<t t-out="t_index + 1"/></span>
                                    <strong class="text-primary"><t t-out="t.source_field"/></strong>
                                    <i class="fa fa-arrow-right text-muted fs-7"/>
                                    <strong class="text-success"><t t-out="t.output_field || t.source_field"/></strong>
                                    <span class="badge bg-info text-dark ms-1"><t t-out="t.transform_category"/></span>
                                    <span t-if="t.apply_filter" class="badge bg-warning text-dark ms-1" title="Conditional Filter Active">
                                        <i class="fa fa-filter me-1"/>Filtered
                                    </span>
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-xs btn-outline-secondary" t-on-click="() => this.moveTransform(t_index, -1)" t-att-disabled="t_index == 0" title="Move Up">
                                        <i class="fa fa-chevron-up"/>
                                    </button>
                                    <button class="btn btn-xs btn-outline-secondary" t-on-click="() => this.moveTransform(t_index, 1)" t-att-disabled="t_index == state.transformations.length - 1" title="Move Down">
                                        <i class="fa fa-chevron-down"/>
                                    </button>
                                    <button class="btn btn-xs btn-outline-danger" t-on-click="() => this.removeTransform(t_index)" title="Delete Rule">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <!-- Input & Output Variable Names -->
                                    <div class="col-md-3">
                                        <label class="form-label fs-7 fw-bold mb-1">Source Variable</label>
                                        <select class="form-select form-select-sm" t-model="t.source_field" t-on-change="() => this.updateDerivedVariables()">
                                            <t t-foreach="state.rawColumns" t-as="rc" t-key="rc">
                                                <option t-att-value="rc"><t t-out="rc"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fs-7 fw-bold mb-1">Category</label>
                                        <select class="form-select form-select-sm" t-model="t.transform_category">
                                            <option value="cleansing">Data Cleansing</option>
                                            <option value="filter_row">Filter / Drop Records</option>
                                            <option value="date_format">Date Formatting</option>
                                            <option value="unit_conversion">Unit Conversion</option>
                                            <option value="type_conversion">Type Casting</option>
                                            <option value="value_map">Value Mapping</option>
                                            <option value="math_expr">Math &amp; Arithmetic</option>
                                            <option value="string_slice">Substring / Split</option>
                                            <option value="slugify">Slugify Code</option>
                                            <option value="case_when">Case-When Logic</option>
                                            <option value="python_expr">Python Expression</option>
                                            <option value="ai_prompt">AI Prompt Transformer</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fs-7 fw-bold mb-1">Output Variable</label>
                                        <input type="text" class="form-control form-control-sm" t-model="t.output_field" t-on-input="() => this.updateDerivedVariables()" placeholder="Output column name"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fs-7 fw-bold mb-1">Fallback Default</label>
                                        <input type="text" class="form-control form-control-sm" t-model="t.default_fallback" placeholder="Default value"/>
                                    </div>

                                    <!-- Category Specific Option Rows -->
                                    <div class="col-12 mt-2 pt-2 border-top">
                                        <!-- Cleansing -->
                                        <div t-if="t.transform_category == 'cleansing'" class="row g-2 align-items-center">
                                            <div class="col-md-4">
                                                <select class="form-select form-select-sm" t-model="t.cleansing_type">
                                                    <option value="trim">Trim Whitespace</option>
                                                    <option value="upper">UPPERCASE</option>
                                                    <option value="lower">lowercase</option>
                                                    <option value="title">Title Case</option>
                                                    <option value="capitalize">Capitalize First Letter</option>
                                                    <option value="pad_left">Pad String Left</option>
                                                    <option value="pad_right">Pad String Right</option>
                                                    <option value="regex">Regex Search &amp; Replace</option>
                                                    <option value="regex_extract">Regex Group Extract</option>
                                                    <option value="strip_html">Strip HTML Tags</option>
                                                    <option value="strip_non_numeric">Strip Non-Numeric</option>
                                                    <option value="strip_non_alphanumeric">Strip Non-Alphanumeric</option>
                                                    <option value="handle_null">Fallback if Null</option>
                                                    <option value="drop_if_null">Skip Record if Null</option>
                                                </select>
                                            </div>
                                            <t t-if="t.cleansing_type == 'regex'">
                                                <div class="col-md-4"><input type="text" class="form-control form-control-sm" placeholder="Regex Pattern" t-model="t.regex_pattern"/></div>
                                                <div class="col-md-4"><input type="text" class="form-control form-control-sm" placeholder="Replacement" t-model="t.regex_replace"/></div>
                                            </t>
                                            <t t-if="t.cleansing_type == 'pad_left' or t.cleansing_type == 'pad_right'">
                                                <div class="col-md-4"><input type="text" class="form-control form-control-sm" placeholder="Pad Char (e.g. 0)" t-model="t.pad_char"/></div>
                                                <div class="col-md-4"><input type="number" class="form-control form-control-sm" placeholder="Length" t-model="t.pad_count"/></div>
                                            </t>
                                        </div>

                                        <!-- Row Filter Category -->
                                        <div t-if="t.transform_category == 'filter_row'" class="row g-2 align-items-center">
                                            <div class="col-md-3">
                                                <select class="form-select form-select-sm" t-model="t.filter_action">
                                                    <option value="keep_if">Keep If Met</option>
                                                    <option value="drop_if">Drop If Met</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" class="form-control form-control-sm" placeholder="Field (defaults to source)" t-model="t.filter_field"/>
                                            </div>
                                            <div class="col-md-3">
                                                <select class="form-select form-select-sm" t-model="t.filter_operator">
                                                    <option value="=">Equals (=)</option>
                                                    <option value="!=">Not Equals (!=)</option>
                                                    <option value="&gt;">Greater Than (&gt;)</option>
                                                    <option value="&lt;">Less Than (&lt;)</option>
                                                    <option value="&gt;=">Greater or Equal (&gt;=)</option>
                                                    <option value="&lt;=">Less or Equal (&lt;=)</option>
                                                    <option value="contains">Contains</option>
                                                    <option value="not_contains">Does Not Contain</option>
                                                    <option value="is_null">Is Null / Empty</option>
                                                    <option value="is_not_null">Is Not Null</option>
                                                    <option value="in">In Set (A, B, C)</option>
                                                    <option value="regex">Regex</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" class="form-control form-control-sm" placeholder="Target Value / Pattern" t-model="t.filter_value"/>
                                            </div>
                                        </div>

                                        <!-- Unit Conversion -->
                                        <div t-if="t.transform_category == 'unit_conversion'" class="row g-2 align-items-center">
                                            <div class="col-md-4">
                                                <select class="form-select form-select-sm" t-model="t.unit_type">
                                                    <option value="mass">Mass / Weight (kg, lb, oz)</option>
                                                    <option value="length">Length (m, km, ft, in)</option>
                                                    <option value="volume">Volume (l, ml, gal)</option>
                                                    <option value="temp">Temperature (C, F, K)</option>
                                                    <option value="custom">Custom Scale Multiplier</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4" t-if="t.unit_type != 'custom'">
                                                <input type="text" class="form-control form-control-sm" placeholder="Source Unit (e.g. lb)" t-model="t.source_unit"/>
                                            </div>
                                            <div class="col-md-4" t-if="t.unit_type != 'custom'">
                                                <input type="text" class="form-control form-control-sm" placeholder="Target Unit (e.g. kg)" t-model="t.target_unit"/>
                                            </div>
                                            <div class="col-md-4" t-if="t.unit_type == 'custom'">
                                                <input type="number" step="any" class="form-control form-control-sm" placeholder="Scale Multiplier Ratio" t-model="t.custom_scale_ratio"/>
                                            </div>
                                        </div>

                                        <!-- Type Conversion -->
                                        <div t-if="t.transform_category == 'type_conversion'" class="row g-2 align-items-center">
                                            <div class="col-md-6">
                                                <select class="form-select form-select-sm" t-model="t.target_type">
                                                    <option value="string">String / Text</option>
                                                    <option value="integer">Integer Number</option>
                                                    <option value="float">Float / Decimal</option>
                                                    <option value="boolean">Boolean (True / False)</option>
                                                    <option value="date">Date Object</option>
                                                    <option value="datetime">Datetime Timestamp</option>
                                                    <option value="json_parse">Parse JSON</option>
                                                    <option value="json_dump">Dump to JSON</option>
                                                    <option value="base64_encode">Base64 Encode</option>
                                                    <option value="base64_decode">Base64 Decode</option>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Math -->
                                        <div t-if="t.transform_category == 'math_expr'" class="row g-2 align-items-center">
                                            <div class="col-md-4">
                                                <select class="form-select form-select-sm" t-model="t.math_op">
                                                    <option value="add">Add (+)</option>
                                                    <option value="subtract">Subtract (-)</option>
                                                    <option value="multiply">Multiply (*)</option>
                                                    <option value="divide">Divide (/)</option>
                                                    <option value="round">Round to Decimal Digits</option>
                                                    <option value="percentage">Percentage (%)</option>
                                                    <option value="abs">Absolute Value</option>
                                                    <option value="modulo">Modulo (%)</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4" t-if="t.math_op != 'round' and t.math_op != 'abs'">
                                                <input type="number" step="any" class="form-control form-control-sm" placeholder="Operand Value" t-model="t.math_operand"/>
                                            </div>
                                        </div>

                                        <!-- Date -->
                                        <div t-if="t.transform_category == 'date_format'" class="row g-2 align-items-center">
                                            <div class="col-md-6"><input type="text" class="form-control form-control-sm" placeholder="Input Date Pattern (%Y-%m-%d)" t-model="t.input_date_format"/></div>
                                            <div class="col-md-6"><input type="text" class="form-control form-control-sm" placeholder="Output Date Pattern (%Y-%m-%d)" t-model="t.output_date_format"/></div>
                                        </div>

                                        <!-- String Slice / Split -->
                                        <div t-if="t.transform_category == 'string_slice'" class="row g-2 align-items-center">
                                            <div class="col-md-4">
                                                <select class="form-select form-select-sm" t-model="t.slice_mode">
                                                    <option value="slice">Slice (Start..End)</option>
                                                    <option value="left">Left N Chars</option>
                                                    <option value="right">Right N Chars</option>
                                                    <option value="split">Split by Delimiter</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4" t-if="t.slice_mode == 'split'">
                                                <input type="text" class="form-control form-control-sm" placeholder="Delimiter (e.g. -)" t-model="t.split_delimiter"/>
                                            </div>
                                        </div>

                                        <!-- AI Prompt -->
                                        <div t-if="t.transform_category == 'ai_prompt'" class="row g-2">
                                            <div class="col-12">
                                                <textarea class="form-control form-control-sm" rows="2" placeholder="AI Prompt: Extract city from {value}..." t-model="t.ai_prompt_template"/>
                                            </div>
                                        </div>

                                        <!-- Python Expr -->
                                        <div t-if="t.transform_category == 'python_expr'" class="row g-2">
                                            <div class="col-12">
                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="Python expr: value.strip().lower() if value else ''" t-model="t.python_code"/>
                                            </div>
                                        </div>

                                        <!-- Conditional Filter Option Toggle for standard transforms -->
                                        <div t-if="t.transform_category != 'filter_row'" class="col-12 mt-2 pt-2 border-top">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" t-model="t.apply_filter" t-att-id="'apply_filter_' + t_index"/>
                                                    <label class="form-check-label fs-7 fw-bold" t-att-for="'apply_filter_' + t_index">
                                                        <i class="fa fa-filter me-1 text-warning"/> Conditional Execution Filter
                                                    </label>
                                                </div>
                                                <small class="text-muted fs-8">Only apply if record matches condition</small>
                                            </div>
                                            <div t-if="t.apply_filter" class="row g-2 align-items-center mt-1 bg-light p-2 rounded">
                                                <div class="col-md-4">
                                                    <input type="text" class="form-control form-control-sm" placeholder="Field to test (defaults to source)" t-model="t.filter_field"/>
                                                </div>
                                                <div class="col-md-4">
                                                    <select class="form-select form-select-sm" t-model="t.filter_operator">
                                                        <option value="=">Equals (=)</option>
                                                        <option value="!=">Not Equals (!=)</option>
                                                        <option value="&gt;">Greater Than (&gt;)</option>
                                                        <option value="&lt;">Less Than (&lt;)</option>
                                                        <option value="&gt;=">Greater or Equal (&gt;=)</option>
                                                        <option value="&lt;=">Less or Equal (&lt;=)</option>
                                                        <option value="contains">Contains</option>
                                                        <option value="not_contains">Does Not Contain</option>
                                                        <option value="is_null">Is Null / Empty</option>
                                                        <option value="is_not_null">Is Not Null</option>
                                                        <option value="in">In Set (A, B, C)</option>
                                                        <option value="regex">Regex</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" class="form-control form-control-sm" placeholder="Filter Target Value" t-model="t.filter_value"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Dynamic Example & Hint Callout -->
                                        <div class="col-12 mt-2">
                                            <div class="p-2 rounded bg-light border-start border-warning border-3 d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center text-truncate me-2">
                                                    <i class="fa fa-lightbulb-o text-warning me-2 fs-6 flex-shrink-0"/>
                                                    <small class="text-muted"><strong class="text-dark">Example: </strong><t t-out="getTransformHint(t)"/></small>
                                                </div>
                                                <button class="btn btn-xs btn-outline-warning text-dark flex-shrink-0" t-on-click="() => this.loadExampleToSandbox(t)" title="Load sample input into test sandbox">
                                                    <i class="fa fa-flask me-1"/>Try in Sandbox
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Right Panel: Live Test Sandbox -->
                <div class="bg-light p-3 d-flex flex-column" style="width: 320px; min-width: 300px;">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="fa fa-flask me-2 text-warning"/>Interactive Test Sandbox
                    </h6>
                    <p class="fs-7 text-muted mb-2">Evaluate the transformation pipeline against sample values:</p>

                    <label class="form-label fs-7 fw-bold">Test Input Value</label>
                    <input type="text" class="form-control form-control-sm mb-2" t-model="state.sampleInput"/>
                    
                    <button class="btn btn-sm btn-primary mb-3" t-on-click="testSampleTransform" t-att-disabled="state.isTestingSample">
                        <i t-if="!state.isTestingSample" class="fa fa-play me-1"/>
                        <i t-if="state.isTestingSample" class="fa fa-spinner fa-spin me-1"/>
                        Run Test Pipeline
                    </button>

                    <div t-if="state.sampleResult !== null" class="card border bg-white shadow-sm p-3">
                        <label class="form-label fs-7 fw-bold text-success mb-1">Evaluated Result:</label>
                        <div class="p-2 bg-light rounded border text-break font-monospace fs-7">
                            <t t-out="state.sampleResult"/>
                        </div>
                    </div>
                </div>

            </div>

            <!-- MODE 2: TARGET FIELD MAPPER -->
            <div t-if="!state.isLoading and state.activeMode == 'mapping'" class="o_visual_mapper_body d-flex flex-grow-1 position-relative overflow-hidden">
                
                <!-- SVG Bezier Connector Canvas -->
                <svg class="o_visual_mapper_svg position-absolute top-0 start-0 w-100 h-100 pe-none" t-ref="svgCanvas" style="z-index: 10; transition: opacity 0.15s ease;"></svg>

                <!-- Left Column: Available Variables (Raw + Derived) -->
                <div class="border-end bg-light d-flex flex-column o_mapper_source_panel" style="min-width: 280px; flex: 1;">
                    <div class="p-3 border-bottom bg-view d-flex align-items-center justify-content-between o_mapper_panel_header">
                        <span class="fw-bold text-uppercase fs-7 text-muted">
                            <i class="fa fa-database me-1"/> Available Variables (<t t-out="state.availableVariables.length"/>)
                        </span>
                        <div class="input-group input-group-sm w-50">
                            <span class="input-group-text"><i class="fa fa-search"/></span>
                            <input type="text" class="form-control" placeholder="Search..." t-model="state.sourceSearch"/>
                        </div>
                    </div>
                    <div class="p-2 overflow-auto flex-grow-1 o_mapper_scroll_pane" t-ref="sourceList" t-on-scroll="() => this.onListScroll()">
                        <t t-foreach="filteredAvailableVariables" t-as="v" t-key="v">
                            <div t-attf-class="d-flex align-items-center justify-content-between p-2 mb-1 rounded cursor-pointer border #{state.selectedSourceCol == v ? 'bg-primary text-white border-primary shadow-sm' : 'bg-view border-light hover-bg-light'} #{state.dragSourceCol == v ? 'opacity-50' : ''}"
                                 t-att-data-source-var="v"
                                 draggable="true"
                                 t-on-dragstart="(e) => this.onSourceDragStart(e, v)"
                                 t-on-dragend="() => this.onDragEnd()"
                                 t-on-click="() => this.selectSource(v)">
                                <div class="d-flex align-items-center text-truncate me-2">
                                    <i class="fa fa-arrows-alt me-2 text-muted cursor-move" title="Drag to map to target field"/>
                                    <span class="fw-semibold text-truncate" t-out="v"/>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span t-if="isVariableDerived(v)" class="badge bg-warning text-dark fs-8">Derived</span>
                                    <span t-if="isSourceMapped(v)" class="badge bg-success fs-8">Mapped</span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Right Column: Target Odoo Model Fields -->
                <div class="bg-light d-flex flex-column o_mapper_target_panel" style="min-width: 380px; flex: 1.5;">
                    <div class="p-3 border-bottom bg-view d-flex align-items-center justify-content-between o_mapper_panel_header">
                        <span class="fw-bold text-uppercase fs-7 text-muted">
                            <i class="fa fa-cubes me-1"/> Target Fields (<t t-out="state.targetFields.length"/>)
                        </span>
                        <div class="input-group input-group-sm w-50">
                            <span class="input-group-text"><i class="fa fa-search"/></span>
                            <input type="text" class="form-control" placeholder="Search target fields..." t-model="state.targetSearch"/>
                        </div>
                    </div>
                    <div class="p-2 overflow-auto flex-grow-1 o_mapper_scroll_pane" t-ref="targetList" t-on-scroll="() => this.onListScroll()">
                        <t t-foreach="filteredTargetFields" t-as="f" t-key="f.id">
                            <div t-attf-class="p-2 mb-2 rounded bg-view border #{state.dragOverTargetId == f.id ? 'border-primary bg-primary-subtle' : 'border-light'} shadow-sm"
                                 t-att-data-target-id="f.id"
                                 t-on-dragover="(e) => this.onTargetDragOver(e, f.id)"
                                 t-on-dragleave="() => this.onTargetDragLeave(f.id)"
                                 t-on-drop="(e) => this.onTargetDrop(e, f)">
                                
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center text-truncate">
                                        <span class="fw-bold text-dark me-2" t-out="f.field_description || f.name"/>
                                        <code class="text-muted fs-8 me-2" t-out="f.name"/>
                                        <span class="badge bg-secondary fs-8"><t t-out="f.ttype"/></span>
                                        <span t-if="f.required" class="badge bg-danger ms-1 fs-8">Required</span>
                                    </div>
                                    
                                    <!-- Match Key Toggle -->
                                    <t t-set="mapping" t-value="getMappingForField(f.id)"/>
                                    <div t-if="mapping" class="d-flex align-items-center gap-1">
                                        <button t-attf-class="btn btn-xs #{mapping.is_key_field ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary'}"
                                                t-on-click="() => this.toggleKeyField(mapping)"
                                                title="Use as unique record matching key for upsert">
                                            <i class="fa fa-key me-1"/>Match Key
                                        </button>
                                        <button class="btn btn-xs btn-outline-danger" t-on-click="() => this.removeMapping(mapping)" title="Unmap field">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </div>

                                <!-- Connected Variable Indicator -->
                                <t t-if="mapping">
                                    <div class="mt-2 p-2 rounded bg-light border d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa fa-link text-success"/>
                                            <span class="fs-7 text-muted">Source:</span>
                                            <strong class="text-primary fs-7" t-out="mapping.source_field"/>
                                        </div>

                                        <!-- Relational Lookup Config for M2O -->
                                        <div t-if="f.ttype == 'many2one'" class="d-flex align-items-center gap-1">
                                            <select class="form-select form-select-sm fs-8 py-0" t-model="mapping.lookup_strategy" style="width: 140px;">
                                                <option value="field_search">Match Field</option>
                                                <option value="xml_id">XML ID</option>
                                                <option value="auto_create">Auto-Create</option>
                                                <option value="record_map">Record Map</option>
                                            </select>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>

            </div>

        </div>
    </t>

</templates>
