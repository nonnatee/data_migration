<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Provider Config List View -->
    <record id="view_migration_ai_config_list" model="ir.ui.view">
        <field name="name">migration.ai.config.list</field>
        <field name="model">migration.ai.config</field>
        <field name="arch" type="xml">
            <list string="AI Provider Configurations">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="is_default" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- AI Provider Config Form View -->
    <record id="view_migration_ai_config_form" model="ir.ui.view">
        <field name="name">migration.ai.config.form</field>
        <field name="model">migration.ai.config</field>
        <field name="arch" type="xml">
            <form string="AI Provider Configuration">
                <header>
                    <button name="action_test_ai_connection"
                            type="object"
                            string="Test AI Connection"
                            class="btn-primary"
                            icon="fa-bolt"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. OpenAI GPT-4o / Local Ollama"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Provider &amp; Model Specification">
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="is_default" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Credentials &amp; Endpoint">
                            <field name="api_key" password="True" invisible="provider == 'ollama'"/>
                            <field name="base_url" placeholder="https://api.openai.com/v1"/>
                            <field name="temperature"/>
                            <field name="max_tokens"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="System Prompt" name="system_prompt">
                            <field name="system_prompt_default" placeholder="Default system instructions for AI assistants..."/>
                        </page>
                        <page string="Connection Error Log" name="error" invisible="not last_error">
                            <field name="last_error" readonly="1" class="text-danger"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_migration_ai_config" model="ir.actions.act_window">
        <field name="name">AI Provider Settings</field>
        <field name="res_model">migration.ai.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your first AI Provider for Data Migration!
            </p>
            <p>
                Connect OpenAI (GPT-4o), Google Gemini, Anthropic Claude, or local Ollama instances to unlock AI Auto-Mapping, Natural Language Data Transformations, and Automated Anomaly Detection.
            </p>
        </field>
    </record>
</odoo>
