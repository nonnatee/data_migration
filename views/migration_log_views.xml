<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_migration_log_list" model="ir.ui.view">
        <field name="name">migration.log.list</field>
        <field name="model">migration.log</field>
        <field name="arch" type="xml">
            <list string="Migration Audit Logs"
                  decoration-danger="log_type == 'error'"
                  decoration-warning="log_type == 'warning'"
                  decoration-success="log_type == 'success'">
                <field name="create_date" string="Timestamp"/>
                <field name="job_id"/>
                <field name="template_id"/>
                <field name="stage_name" optional="show"/>
                <field name="step_name" optional="show"/>
                <field name="row_number"/>
                <field name="source_key"/>
                <field name="log_type" widget="badge"
                       decoration-danger="log_type == 'error'"
                       decoration-warning="log_type == 'warning'"
                       decoration-success="log_type == 'success'"
                       decoration-info="log_type == 'info'"/>
                <field name="message"/>
                <field name="target_record_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_migration_log_form" model="ir.ui.view">
        <field name="name">migration.log.form</field>
        <field name="model">migration.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry Detail">
                <header>
                    <button name="action_ask_ai_for_resolution"
                            type="object"
                            string="Ask AI for Fix Suggestion"
                            class="btn-outline-primary"
                            icon="fa-lightbulb-o"
                            invisible="log_type != 'error'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Execution Context">
                            <field name="job_id"/>
                            <field name="template_id"/>
                            <field name="stage_name"/>
                            <field name="step_name"/>
                            <field name="log_type"/>
                        </group>
                        <group string="Record Identification">
                            <field name="row_number"/>
                            <field name="source_key"/>
                            <field name="target_record_id"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>

                    <group string="Message">
                        <field name="message" readonly="1"/>
                    </group>

                    <group string="AI Resolution Suggestion" invisible="not ai_resolution_suggestion">
                        <field name="ai_resolution_suggestion" readonly="1" class="alert alert-info"/>
                    </group>

                    <group string="Error Traceback" invisible="not error_traceback">
                        <field name="error_traceback" widget="ace" readonly="1"/>
                    </group>

                    <group string="Data Payloads">
                        <field name="raw_data" widget="ace" options="{'mode': 'json'}" readonly="1" invisible="not raw_data"/>
                        <field name="transformed_data" widget="ace" options="{'mode': 'json'}" readonly="1" invisible="not transformed_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_migration_log" model="ir.actions.act_window">
        <field name="name">Migration Audit Logs</field>
        <field name="res_model">migration.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
