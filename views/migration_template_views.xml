<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template List View -->
    <record id="view_migration_template_list" model="ir.ui.view">
        <field name="name">migration.template.list</field>
        <field name="model">migration.template</field>
        <field name="arch" type="xml">
            <list string="Mapping Templates">
                <field name="name"/>
                <field name="connection_id"/>
                <field name="target_model_id"/>
                <field name="operation_mode"/>
                <field name="transform_line_count" string="Transforms"/>
                <field name="mapping_line_count" string="Mappings"/>
                <field name="validation_rule_count" string="Validation Rules"/>
                <field name="record_map_count" string="Mapped Records"/>
                <field name="quality_score" widget="progressbar" string="Quality Health"/>
            </list>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="view_migration_template_form" model="ir.ui.view">
        <field name="name">migration.template.form</field>
        <field name="model">migration.template</field>
        <field name="arch" type="xml">
            <form string="Mapping Template">
                <header>
                    <button name="action_open_run_wizard" type="object" string="Run Migration Job" class="btn-primary" icon="fa-play"/>
                    <button name="action_test_preview" type="object" string="Preview Pipeline" class="btn-outline-success" icon="fa-play-circle"/>
                    <button name="action_auto_map_fields" type="object" string="Auto-Map Fields" class="btn-secondary" icon="fa-magic"/>
                    <button name="action_ai_auto_map_fields" type="object" string="AI Auto-Map" class="btn-outline-primary" icon="fa-bolt"/>
                    <button name="action_ai_suggest_validation_rules" type="object" string="AI Suggest Rules" class="btn-outline-info" icon="fa-check-circle"/>
                    <button name="action_audit_data_quality" type="object" string="Audit Data Quality" class="btn-outline-secondary" icon="fa-stethoscope"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_record_mappings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-link">
                            <field name="record_map_count" widget="statinfo" string="Mapped Records"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Customer Contacts Migration Template"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Source &amp; Target Setup">
                            <field name="connection_id"/>
                            <field name="extraction_id" domain="[('connection_id', '=', connection_id)]"/>
                            <field name="target_model_id" options="{'no_create': True}"/>
                            <field name="target_model_name" invisible="1"/>
                        </group>
                        <group string="Execution Parameters">
                            <field name="operation_mode"/>
                            <field name="batch_size"/>
                            <field name="bypass_tracking" widget="boolean_toggle"/>
                            <field name="bypass_subscription" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Visual Studio &amp; Mapper" name="visual_diagram">
                            <widget name="visual_mapper"/>
                        </page>

                        <!-- STAGE 1: DATA TRANSFORMATION -->
                        <page string="Stage 1: Data Transformations" name="transformations">
                            <field name="transform_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_field"/>
                                    <field name="transform_category"/>
                                    <field name="apply_filter" widget="boolean_toggle" string="Filtered"/>
                                    <field name="cleansing_type" invisible="transform_category != 'cleansing'"/>
                                    <field name="filter_action" invisible="transform_category != 'filter_row'"/>
                                    <field name="unit_type" invisible="transform_category != 'unit_conversion'"/>
                                    <field name="target_type" invisible="transform_category != 'type_conversion'"/>
                                    <field name="math_op" invisible="transform_category != 'math_expr'"/>
                                    <field name="output_field"/>
                                    <field name="usage_hint" string="Hint / Example" optional="show"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                                <form string="Transformation Rule Detail">
                                    <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center" invisible="not usage_hint">
                                        <i class="fa fa-lightbulb-o text-warning me-2 fs-5"/>
                                        <div>
                                            <strong>Example &amp; Hint: </strong>
                                            <field name="usage_hint" class="d-inline fw-semibold text-dark" readonly="1"/>
                                        </div>
                                    </div>
                                    <group>
                                        <group string="Variable Mapping">
                                            <field name="sequence"/>
                                            <field name="source_field"/>
                                            <field name="output_field"/>
                                            <field name="transform_category"/>
                                            <field name="apply_filter" widget="boolean_toggle"/>
                                            <field name="active"/>
                                        </group>
                                        <group string="Conditional Filter Rule" invisible="not apply_filter and transform_category != 'filter_row'">
                                            <field name="filter_action" invisible="transform_category != 'filter_row'"/>
                                            <field name="filter_field" placeholder="Leave empty to use source field"/>
                                            <field name="filter_operator"/>
                                            <field name="filter_value" placeholder="e.g. active, 100, or regex"/>
                                        </group>
                                    </group>
                                    <group string="Cleansing Settings" invisible="transform_category != 'cleansing'">
                                        <field name="cleansing_type"/>
                                        <field name="pad_char" invisible="cleansing_type not in ('pad_left', 'pad_right')"/>
                                        <field name="pad_count" invisible="cleansing_type not in ('pad_left', 'pad_right')"/>
                                        <field name="regex_pattern" invisible="cleansing_type not in ('regex', 'regex_extract')"/>
                                        <field name="regex_replace" invisible="cleansing_type != 'regex'"/>
                                        <field name="regex_group_index" invisible="cleansing_type != 'regex_extract'"/>
                                        <field name="default_fallback" invisible="cleansing_type != 'handle_null'"/>
                                    </group>
                                    <group string="Date &amp; Time Settings" invisible="transform_category != 'date_format'">
                                        <field name="input_date_format"/>
                                        <field name="output_date_format"/>
                                        <field name="tz_offset_hours"/>
                                        <field name="date_math_days"/>
                                    </group>
                                    <group string="Unit Conversion Settings" invisible="transform_category != 'unit_conversion'">
                                        <field name="unit_type"/>
                                        <field name="source_unit" invisible="unit_type == 'custom'"/>
                                        <field name="target_unit" invisible="unit_type == 'custom'"/>
                                        <field name="custom_scale_ratio" invisible="unit_type != 'custom'"/>
                                    </group>
                                    <group string="Data Type Casting" invisible="transform_category != 'type_conversion'">
                                        <field name="target_type"/>
                                    </group>
                                    <group string="Value Mapping Table" invisible="transform_category != 'value_map'">
                                        <field name="value_mapping_json" widget="ace" options="{'mode': 'json'}"/>
                                        <field name="default_fallback"/>
                                    </group>
                                    <group string="Math &amp; Arithmetic" invisible="transform_category != 'math_expr'">
                                        <field name="math_op"/>
                                        <field name="math_operand" invisible="math_op in ('round', 'abs')"/>
                                        <field name="math_round_precision" invisible="math_op != 'round'"/>
                                    </group>
                                    <group string="String Substring / Split" invisible="transform_category != 'string_slice'">
                                        <field name="slice_mode"/>
                                        <field name="slice_start" invisible="slice_mode != 'slice'"/>
                                        <field name="slice_end" invisible="slice_mode != 'slice'"/>
                                        <field name="slice_length" invisible="slice_mode in ('slice', 'split')"/>
                                        <field name="split_delimiter" invisible="slice_mode != 'split'"/>
                                        <field name="split_index" invisible="slice_mode != 'split'"/>
                                    </group>
                                    <group string="Case-When Logic" invisible="transform_category != 'case_when'">
                                        <field name="case_when_json" widget="ace" options="{'mode': 'json'}"/>
                                        <field name="default_fallback"/>
                                    </group>
                                    <group string="Custom Python Expression" invisible="transform_category != 'python_expr'">
                                        <field name="python_code" widget="ace" options="{'mode': 'python'}"/>
                                        <field name="default_fallback"/>
                                    </group>
                                    <group string="AI Prompt NLP Transformer" invisible="transform_category != 'ai_prompt'">
                                        <field name="ai_prompt_template" placeholder="e.g. Extract the province from this address: {value}"/>
                                        <field name="default_fallback"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- STAGE 2: TARGET FIELD MAPPING -->
                        <page string="Stage 2: Field Mappings" name="mappings">
                            <field name="mapping_line_ids">
                                <list editable="bottom" decoration-info="is_key_field == True">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_field"/>
                                    <field name="target_field_id" options="{'no_create': True}"/>
                                    <field name="target_field_ttype" optional="show"/>
                                    <field name="default_value" optional="hide"/>
                                    <field name="lookup_strategy" invisible="target_field_ttype not in ('many2one', 'many2many', 'one2many')"/>
                                    <field name="lookup_field_id" invisible="lookup_strategy not in ('field_search', 'auto_create')" options="{'no_create': True}"/>
                                    <field name="is_key_field" string="Match Key"/>
                                </list>
                                <form string="Field Mapping Detail">
                                    <group>
                                        <group string="Mapping Configuration">
                                            <field name="source_field"/>
                                            <field name="target_field_id"/>
                                            <field name="target_field_ttype"/>
                                            <field name="relation_model" invisible="not relation_model"/>
                                            <field name="is_key_field"/>
                                            <field name="default_value"/>
                                        </group>
                                        <group string="Relational Resolution" invisible="target_field_ttype not in ('many2one', 'many2many', 'one2many')">
                                            <field name="lookup_strategy"/>
                                            <field name="lookup_field_id" invisible="lookup_strategy not in ('field_search', 'auto_create')"/>
                                            <field name="lookup_domain" invisible="lookup_strategy != 'domain_expr'"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- STAGE 3: VALIDATION RULES -->
                        <page string="Validation Rules" name="validation_rules">
                            <field name="validation_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="rule_timing"/>
                                    <field name="source_field"/>
                                    <field name="rule_type"/>
                                    <field name="action_on_failure" widget="badge"
                                           decoration-danger="action_on_failure in ('reject_record', 'abort_stage')"
                                           decoration-warning="action_on_failure == 'warning'"/>
                                    <field name="error_message"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                                <form string="Validation Rule Detail">
                                    <group>
                                        <group string="Rule Identification">
                                            <field name="name"/>
                                            <field name="rule_timing"/>
                                            <field name="source_field"/>
                                            <field name="target_field_id"/>
                                            <field name="active"/>
                                        </group>
                                        <group string="Rule Specification">
                                            <field name="rule_type"/>
                                            <field name="action_on_failure"/>
                                            <field name="error_message"/>
                                        </group>
                                    </group>
                                    <group string="Constraint Parameters">
                                        <field name="regex_pattern" invisible="rule_type != 'regex'"/>
                                        <field name="allowed_values" invisible="rule_type != 'value_in_set'"/>
                                        <field name="min_value" invisible="rule_type != 'numeric_range'"/>
                                        <field name="max_value" invisible="rule_type != 'numeric_range'"/>
                                        <field name="fk_model" invisible="rule_type != 'foreign_key'"/>
                                        <field name="fk_field" invisible="rule_type != 'foreign_key'"/>
                                        <field name="python_code" invisible="rule_type not in ('custom_python', 'business_integrity')" widget="ace" options="{'mode': 'python'}"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- STAGE 3: DATA PREVIEW & AUDIT -->
                        <page string="Stage 3: Data Preview &amp; Audit" name="pipeline_preview">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h4 class="mb-1 text-primary"><i class="fa fa-table me-2"/>End-to-End Pipeline Data Preview</h4>
                                    <p class="text-muted mb-0">Runs top 10 sample records through extraction, transformations, validations, and target field mapping without writing to database.</p>
                                </div>
                                <button name="action_test_preview" type="object" string="Re-run Pipeline Preview" class="btn btn-sm btn-primary" icon="fa-refresh"/>
                            </div>
                            <group>
                                <group string="Preview Runtime Statistics">
                                    <field name="preview_records_count" string="Extracted Sample Records" readonly="1"/>
                                    <field name="preview_latency" string="Pipeline Execution Latency (ms)" readonly="1"/>
                                </group>
                            </group>
                            <field name="preview_data" widget="text" readonly="1" invisible="not preview_data"/>
                        </page>

                        <page string="Quality &amp; Audit Report" name="quality_report">
                            <group>
                                <field name="quality_score" widget="progressbar"/>
                            </group>
                            <field name="quality_report" readonly="1" placeholder="Run Data Quality Audit to inspect completeness and duplicates..."/>
                        </page>

                        <page string="Execution History" name="history">
                            <field name="job_ids" readonly="1">
                                <list string="Jobs">
                                    <field name="name"/>
                                    <field name="start_time"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state == 'done_with_errors'"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="total_records"/>
                                    <field name="success_records"/>
                                    <field name="error_records"/>
                                    <field name="progress_percent" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_migration_template" model="ir.actions.act_window">
        <field name="name">Mapping Templates</field>
        <field name="res_model">migration.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Data Migration Template!
            </p>
            <p>
                Configure sequential Data Transformations (cleansing, math, derivations) and map clean variables to Odoo target fields.
            </p>
        </field>
    </record>

    <!-- Quick Run Wizard Form View -->
    <record id="view_migration_run_wizard_form" model="ir.ui.view">
        <field name="name">migration.run.wizard.form</field>
        <field name="model">migration.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Execute Migration Job">
                <sheet>
                    <group>
                        <group string="Template &amp; Connection">
                            <field name="template_id" readonly="1"/>
                            <field name="connection_id" readonly="1"/>
                        </group>
                        <group string="Source Override (Optional)">
                            <field name="override_file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_start_migration" type="object" string="Start Migration" class="btn-primary" icon="fa-play"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
