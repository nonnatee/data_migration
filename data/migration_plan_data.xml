<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Built-in Sample Multi-Stage Migration Plan -->
        <record id="plan_preset_standard_master" model="migration.plan">
            <field name="name">Standard Master Data &amp; Product Catalog Migration Plan</field>
            <field name="sequence">10</field>
            <field name="default_error_policy">abort_stage</field>
            <field name="description"><![CDATA[
<p><strong>Standard 2-Stage Master Data Migration Plan:</strong></p>
<ul>
    <li><strong>Stage 1:</strong> Customer &amp; Vendor Contacts (<code>res.partner</code>). Establishes cross-reference keys in <code>migration.record.map</code>.</li>
    <li><strong>Stage 2:</strong> Product Catalog (<code>product.template</code>). Resolves suppliers, categories, and references from Stage 1.</li>
</ul>
            ]]></field>
        </record>

        <!-- Stage 1: Contacts & Business Partners -->
        <record id="stage_preset_master_partners" model="migration.plan.stage">
            <field name="plan_id" ref="plan_preset_standard_master"/>
            <field name="name">01 - Customer &amp; Vendor Partners</field>
            <field name="sequence">10</field>
            <field name="error_policy">abort_stage</field>
            <field name="description">Imports partner records, customer/vendor codes, contact details, and VAT identifiers.</field>
        </record>

        <record id="step_preset_partners" model="migration.plan.step">
            <field name="stage_id" ref="stage_preset_master_partners"/>
            <field name="sequence">10</field>
            <field name="name">Migrate Partner Contacts</field>
            <field name="template_id" ref="template_preset_res_partner"/>
            <field name="error_policy">abort_stage</field>
        </record>

        <!-- Stage 2: Product Catalog -->
        <record id="stage_preset_master_catalog" model="migration.plan.stage">
            <field name="plan_id" ref="plan_preset_standard_master"/>
            <field name="name">02 - Product Catalog &amp; Items</field>
            <field name="sequence">20</field>
            <field name="error_policy">abort_stage</field>
            <field name="description">Imports product master records, SKUs, barcode references, and list prices.</field>
        </record>

        <record id="step_preset_products" model="migration.plan.step">
            <field name="stage_id" ref="stage_preset_master_catalog"/>
            <field name="sequence">10</field>
            <field name="name">Migrate Product Items</field>
            <field name="template_id" ref="template_preset_product_template"/>
            <field name="error_policy">continue_with_warning</field>
        </record>
    </data>
</odoo>
